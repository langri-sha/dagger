"""
Change-file checks for pnpm workspaces released with Beachball: whether every
changed package has a change file, and a generator that writes them.

Beachball compares HEAD to a target branch, so these need the checkout's full
history, which `actions/checkout` only gives with `fetch-depth: 0`.
"""
type Beachball {
  """
  The workspace source, without what installing and building create.
  """
  pub source: Directory!

  """
  The base image to use. Beachball runs git, so it has to ship it.
  """
  pub baseImageAddress: String!

  """
  The ref to compare HEAD to, as Beachball's `branch` option takes it.
  """
  pub branch: String!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24",
    branch: String! = "origin/main",
  ) {
    self.source = ws.directory("/", exclude: installed)
    self.baseImageAddress = baseImageAddress
    self.branch = branch
    self
  }

  """
  Check that every changed package has a change file.
  """
  pub changeFiles(ws: Workspace!): Void @check {
    compared(ws)
      .withExec([
        "pnpm", "exec", "beachball", "check",
        "--no-fetch", "--branch", branch,
      ])
      .sync

    null
  }

  """
  Write a change file for every changed package that lacks one.
  """
  pub change(
    ws: Workspace!,
    message: String! = "Update dependencies",
    type: String! = "patch",
  ): Changeset! @generate {
    compared(ws)
      .withExec([
        "pnpm", "exec", "beachball", "change",
        "--no-commit", "--no-fetch", "--yes",
        "--branch", branch, "--type", type, "--message", message,
      ])
      .directory("/src")
      .filter(include: ["change/**"])
      .changes(source.filter(include: ["change/**"]))
  }

  """
  Paths that installing and building create.
  """
  let installed: [String!]! = [
    ".git",
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/.tsbuild",
    "**/*.tsbuildinfo",
  ]

  """
  The workspace with its dependencies installed from the lock file.
  """
  let base: Container! {
    container
      .from(baseImageAddress)
      .withMountedCache("/pnpm/store", cacheVolume("pnpm-store"))
      .withEnvVariable("npm_config_store_dir", "/pnpm/store")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("HUSKY", "0")
      .withExec(["corepack", "enable"])
      .withDirectory("/src", source)
      .withWorkdir("/src")
      .withExec(["pnpm", "install", "--frozen-lockfile"])
  }

  """
  The installed workspace on a history of two commits: the one HEAD is
  compared to, and HEAD's tree on top of it. Beachball's diff against `branch`
  is then the change under review, and the rest of the checkout's history stays
  out of the container.
  """
  let compared(ws: Workspace!): Container! {
    let head = ws.git.head
    let target = head.asRepository.ref(forkPoint(ws))
    let commit = head.targetCommit

    let history = target
      .withCommit(
        commit.changes(against: target.targetCommit),
        message: commit.message,
        date: commit.authoredDate,
        authorName: commit.authorName,
        authorEmail: commit.authorEmail,
        committerName: commit.committerName,
        committerEmail: commit.committerEmail,
        committerDate: commit.committedDate,
        allowEmpty: true,
      )
      .tree(depth: 2)
      .directory(".git")

    base
      .withDirectory("/src/.git", history)
      .withExec(["git", "update-ref", "refs/remotes/" + branch, target.commitSHA])
  }

  """
  The commit on `branch` to compare HEAD to. The history is read here, not in
  the constructor, so that a shallow checkout fails the functions that need it
  and nothing else.

  The engine hands over HEAD's history, without the checkout's other refs, so
  `branch` isn't in it. On a pull request's merge commit the first parent is
  the target branch, and stands in for it with a warning; any other HEAD has
  nothing to compare against, and fails.
  """
  let forkPoint(ws: Workspace!): String! {
    let parents = ws.git.head.targetCommit.parentShas rescue {
      else => raise "beachball needs the full git history, and this checkout is shallow: set fetch-depth: 0 on the checkout step."
    }

    if (parents.length < 2) {
      raise branch + " is not in the checkout and HEAD is not a merge commit, so there is nothing to compare against."
    }

    print("warning: " + branch + " is not in the checkout, comparing against HEAD^1.")
    parents[0]!
  }
}
