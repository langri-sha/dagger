"""
Workspace generators and fixes that have no official module: projen, package
manifests, ESLint and Prettier fixes, and Vitest snapshots.
"""
type Ci {
  """
  The workspace source.
  """
  pub source: Directory!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24",
  ) {
    self.source = ws.directory("/", exclude: installed)
    self.baseImageAddress = baseImageAddress
    self
  }

  """
  Synthesize the projen configuration and refresh the lock file. Synthesis
  runs again once its changes are installed, so an updated projen component
  writes its own output.
  """
  pub projen: Changeset! @generate {
    changed(
      base
        .withExec(["pnpm", "projen", "--no-post"])
        .withExec(["pnpm", "install", "--no-frozen-lockfile"])
        .withExec(["pnpm", "projen"])
        .withExec(["pnpm", "install", "--no-frozen-lockfile"]),
    )
  }

  """
  Fix what ESLint can, then format with Prettier, each when the workspace
  installs it. Problems ESLint can't fix are left for a lint check to report.
  It isn't a generator, whose stale check would repeat the ESLint and Prettier
  modules' checks.
  """
  pub fix: Changeset! {
    let linted = if (installs("eslint")) {
      let ran = base.withExec(["pnpm", "exec", "eslint", "--fix", "."], expect: ReturnType.ANY)
      # ESLint exits 1 when problems it can't fix remain, and 2 when it can't
      # run.
      if (ran.exitCode > 1) {
        raise "eslint --fix failed (exit " + toString(ran.exitCode) + "):\n" + (ran.stderr + "\n" + ran.stdout).trimSpace
      }
      ran
    } else {
      base
    }

    if (installs("prettier")) {
      changed(linted.withExec(["pnpm", "exec", "prettier", "--write", "."]))
    } else {
      changed(linted)
    }
  }

  """
  Update Vitest's snapshots, when the workspace installs Vitest. It isn't a
  generator, whose stale check would rerun the suite next to the Vitest
  module's tests, and which every `dagger generate` would run to accept any
  changed snapshot.
  """
  pub snapshots: Changeset! {
    if (installs("vitest")) {
      changed(base.withExec(["pnpm", "exec", "vitest", "run", "--update", "--passWithNoTests"]))
    } else {
      changed(base)
    }
  }

  """
  Sort and fix the package manifests.
  """
  pub packages: Changeset! @generate {
    base
      .withExec([
        "pnpm", "dlx", "sort-package-json@latest",
        "package.json", "apps/*/package.json", "packages/*/package.json",
      ])
      .withExec(["pnpm", "-r", "exec", "npm", "pkg", "fix"])
      .directory("/src")
      .filter(include: ["**/package.json"], exclude: installed)
      .changes(source.filter(include: ["**/package.json"]))
  }

  """
  Paths that installing and building create.
  """
  let installed: [String!]! = [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/.tsbuild",
    "**/*.tsbuildinfo",
  ]

  """
  What pnpm reads to resolve and install: the lock file, its settings, patches
  and pnpmfiles, and every workspace manifest. The dependencies install from
  these alone, and their build scripts run, in layers that a change to any
  other file leaves cached. The workspace's own `prepare` and `postinstall`
  scripts wait for the whole source: pnpm skips them when a second install has
  nothing to do, so `pnpm rebuild --pending` runs them afterwards. The install
  before it only brings directory dependencies, which these inputs hold just the
  manifests of, up to date.
  """
  let installInputs: Directory! {
    source.filter(include: [
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "**/.npmrc",
      "**/package.json",
      "**/*.patch",
      "**/.pnpmfile.*",
    ])
  }

  """
  The workspace with its dependencies installed.
  """
  let base: Container! {
    container
      .from(baseImageAddress)
      .withMountedCache("/pnpm/store", cacheVolume("pnpm-store"))
      .withEnvVariable("PNPM_CONFIG_STORE_DIR", "/pnpm/store")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("HUSKY", "0")
      .withExec(["corepack", "enable"])
      .withFile("/src/package.json", source.file("package.json"))
      .withWorkdir("/src")
      .withExec(["pnpm", "--version"])
      .withDirectory("/src", installInputs)
      .withExec(["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"])
      .withExec(["pnpm", "rebuild"])
      .withDirectory("/src", source)
      .withExec(["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"])
      .withExec(["pnpm", "rebuild", "--pending"])
  }

  """
  What a container changed in the installed workspace, among the files git
  would track.
  """
  let changed(ran: Container!): Changeset! {
    tracked(ran).changes(tracked(base))
  }

  """
  A container's workspace without what installing and building create, or
  what the workspace ignores.
  """
  let tracked(ran: Container!): Directory! {
    ran.directory("/src").filter(exclude: installed, gitignore: true)
  }

  """
  Whether the workspace installs a command with this name.
  """
  let installs(command: String!): Boolean! {
    base.exists("/src/node_modules/.bin/" + command)
  }
}
