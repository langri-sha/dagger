"""
Builds a Next.js app in a pnpm workspace with the `next` the lock file
installs, keeping Next's build cache between runs.
"""
type Next {
  """
  The app's directory, relative to the workspace root.
  """
  pub app: String!

  """
  The directory the build writes, relative to the app: `.next`, or for a static
  export `out` or the `distDir` it names.
  """
  pub outDir: String!

  """
  Environment variables for the build, as `NAME=value`.
  """
  pub environment: [String!]!

  """
  The name of the build cache volume, `next-` and this key. Next's cache
  depends on `basePath`, so installs that build the same app with different base
  paths need different keys. Defaults to the app.
  """
  pub cacheKey: String!

  """
  Secret environment variables for the build, as dotenv lines (`NAME=value`,
  blank lines and `#` comments allowed). The build loads them in the exec that
  runs `next build`, from a mounted secret, so they stay out of every layer.
  """
  pub secretEnvFile: Secret

  """
  The workspace with its dependencies installed, from the typescript module.
  """
  pub installed: Container!

  new(
    ws: Workspace!,
    app: String! = ".",
    baseImageAddress: String! = "node:24-slim",
    outDir: String! = ".next",
    environment: [String!]! = [],
    cacheKey: String! = "",
    secretEnvFile: Secret,
  ) {
    self.app = app
    self.outDir = outDir
    self.environment = environment
    self.cacheKey = if (cacheKey == "") { app } else { cacheKey }
    self.secretEnvFile = secretEnvFile
    self.installed = typescript(ws: ws, baseImageAddress: baseImageAddress).base
    self
  }

  """
  The build output.
  """
  pub build: Directory! {
    built.directory(outDir)
  }

  """
  Check that the app builds.
  """
  pub builds: Void @check {
    built.sync

    null
  }

  """
  The app, built. Next keeps its cache in `.next/cache` even when it exports to
  another directory, and clears an export directory before writing it, so the
  cache volume can't go anywhere else.
  """
  let built: Container! {
    let configured = installed
      .withWorkdir("/src/" + app)
      .withMountedCache(".next/cache", cacheVolume("next-" + cacheKey))
      .withEnvVariable("NEXT_TELEMETRY_DISABLED", "1")

    let configuredEnv = environment
      .reduce(configured) { ctr, variable =>
        let pair = variable.split("=", limit: 2)
        if (pair.length < 2) {
          raise variable + " is not NAME=value."
        }
        ctr.withEnvVariable(pair[0]!, pair[1]!)
      }

    if (secretEnvFile == null) {
      configuredEnv.withExec(["pnpm", "exec", "next", "build"])
    } else {
      configuredEnv
        .withMountedSecret("/run/secrets/build-env", secretEnvFile!)
        .withFile("/run/build-with-secrets.sh", currentModule.source.file("build-with-secrets.sh"))
        .withExec(["sh", "/run/build-with-secrets.sh"])
    }
  }
}
