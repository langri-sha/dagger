"""
Resolve the Dagger checks a change puts in scope using first-match path rules.
"""
type Scope {
  """
  Select checks for a tested merge commit using its first parent's rules.
  Return JSON with dagger check arguments and a Markdown summary. An empty
  argument list means run the full suite.
  """
  pub resolveMerge(
    ws: Workspace!,
    """
    The expected commit under test.
    """
    mergeSha: String!,
    """
    The expected head of the pull request.
    """
    headSha: String!,
    """
    Check names or modules to include on every scoped run.
    """
    always: [String!]! = [],
  ): String! {
    let checks = ws.artifacts
      .filterTypes(["Check"])
      .pathDefinitions(typeAssertion: true)
      .{{uri}}
      .map { check => check.uri }

    container
      .from("node:24")
      .withWorkdir("/scope")
      .withFile("package.json", currentModule.source.file("package.json"))
      .withFile("package-lock.json", currentModule.source.file("package-lock.json"))
      .withExec(["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"])
      .withFile("scope.mjs", currentModule.source.file("scope.mjs"))
      .withDirectory("/git", gitDir(ws))
      .withNewFile("/inputs/merge.json", JSON.encode([mergeSha, headSha]))
      .withNewFile("/inputs/checks.json", JSON.encode(checks))
      .withNewFile("/inputs/main.json", JSON.encode(ws.main))
      .withNewFile("/inputs/always.json", JSON.encode(always))
      .withExec(["node", "scope.mjs"])
      .stdout
  }

  let gitDir(ws: Workspace!): Directory! {
    # Workspace.git cannot reconstruct shallow history with missing grandparents.
    ws.directory("/.git", include: ["HEAD", "objects/**", "packed-refs", "refs/**", "shallow"])
  }
}
