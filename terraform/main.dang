"""
Checks for a Terraform root module: formatting, validation, tests and the lock
file. They stay credential-free, initializing with `-backend=false` against
mocked providers, so plan and apply remain out of reach. Each instance mounts
only its root module's directory and the paths `include` adds, so a change
elsewhere leaves its checks cached.
"""
type Terraform {
  """
  The Terraform sources: the root module's own directory, and the paths
  `include` adds.
  """
  pub source: Directory!

  """
  The root module to initialize, validate and test, relative to the workspace
  root. Its `required_version` picks the Terraform to run.
  """
  pub rootModule: String!

  """
  Further workspace paths to mount beside the root module, for a root that reads
  files from outside its directory, as globs relative to the workspace root:
  the shared modules it calls, such as `terraform/modules/network/**`, or the
  files it reads. A root that reads the whole tree sets
  `include = ["terraform/**"]`.
  """
  pub include: [String!]!

  """
  Names the provider cache volume. Root modules that share a key wait on each
  other's checks, so give each its own. Defaults to the root module.
  """
  pub cacheKey: String!

  new(
    ws: Workspace!,
    rootModule: String! = "terraform",
    include: [String!]! = [],
    cacheKey: String! = "",
  ) {
    if (rootModule.hasPrefix("/") or rootModule.split("/").contains("..")) {
      raise "rootModule " + rootModule + " must be relative to the workspace root, with no .. segment."
    }
    include.each { path =>
      if (path.hasPrefix("/") or path.split("/").contains("..")) {
        raise "include " + path + " must be relative to the workspace root, with no .. segment."
      }
    }
    self.source = ws.directory(
      "/",
      include: [rootModule + "/**"] + include,
      exclude: initialized,
    )
    self.rootModule = rootModule
    self.include = include
    self.cacheKey = if (cacheKey == "") { rootModule } else { cacheKey }
    self
  }

  """
  Check the formatting of every Terraform file the root module mounts: its own
  directory and the paths `include` adds.
  """
  pub fmt: Void @check {
    base.withExec(["terraform", "fmt", "-recursive", "-check"]).sync

    null
  }

  """
  Validate the root module.
  """
  pub validate: Void @check {
    root.withExec(["terraform", "validate"]).sync

    null
  }

  """
  Run the root module's tests.
  """
  pub test: Void @check {
    root.withExec(["terraform", "test"]).sync

    null
  }

  """
  Update the root module's dependency lock file.
  """
  pub lock: Changeset! @generate {
    root
      .directory("/src")
      .filter(exclude: initialized)
      .changes(source)
  }

  """
  Paths that initializing creates.
  """
  let initialized: [String!]! = [
    "**/.terraform",
  ]

  """
  The exact Terraform version the root module pins with `required_version`.
  """
  let version: String! {
    let pins = source.search(
      paths: [rootModule],
      globs: ["*.tf"],
      pattern: `required_version\s*=\s*"\d+\.\d+\.\d+"`,
    ).{{matchedLines}}

    if (pins.length == 0) {
      raise `${rootModule} must pin an exact required_version`
    }

    pins[0].matchedLines.split("\"")[1]!
  }

  """
  The source in the Terraform image.
  """
  let base: Container! {
    container
      .from("hashicorp/terraform:" + version)
      .withEnvVariable("TF_IN_AUTOMATION", "1")
      .withDirectory("/src", source)
      .withWorkdir("/src")
  }

  """
  The root module, initialized without a backend. Providers and modules come
  off the registry; nothing else reaches out. Terraform's plugin cache is not
  safe for concurrent writers, so the volume is locked, and only root modules
  sharing a `cacheKey` wait on each other.
  """
  let root: Container! {
    base
      .withMountedCache(
        path: "/plugins",
        cache: cacheVolume("terraform-plugins-" + cacheKey),
        sharing: CacheSharingMode.LOCKED,
      )
      .withEnvVariable("TF_PLUGIN_CACHE_DIR", "/plugins")
      .withWorkdir("/src/" + rootModule)
      .withExec(["terraform", "init", "-backend=false"])
  }
}
