"""
Checks for pnpm workspaces: every TypeScript project reference, built with the
`tsc` the lock file installs, and, when opted in, every package's
`prepublishOnly` build.
"""
type Typescript {
  """
  The workspace source, without what installing and building create.
  """
  pub source: Directory!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  """
  The projects to build, as `tsc --build` takes them: a directory or a tsconfig
  file, relative to the workspace root.
  """
  pub projects: [String!]!

  """
  Whether the `publishable` check does anything. It is off unless a consumer
  opts in: `prepublishOnly` scripts build and may have side effects.
  """
  pub prepublish: Boolean!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24-slim",
    projects: [String!]! = ["."],
    prepublish: Boolean! = false,
  ) {
    self.source = ws.directory("/", exclude: installed)
    self.baseImageAddress = baseImageAddress
    self.projects = projects
    self.prepublish = prepublish
    self
  }

  """
  Type-check every project and the references they build.
  """
  pub typeCheck: Void @check {
    base.withExec(["pnpm", "exec", "tsc", "--build"] + projects).sync

    null
  }

  """
  Run the `prepublishOnly` script of every package that has one, the workspace
  root included, as publishing would, then validate every `.jsii` assembly they
  leave behind with `jsii-tree`. A change that only breaks that build otherwise
  passes the checks and fails the release. Does nothing unless `prepublish` is
  set.
  """
  pub publishable: Void @check {
    if (prepublish) {
      let built = base.withExec([
        "pnpm",
        "-r",
        "--if-present",
        "--include-workspace-root",
        "run",
        "prepublishOnly",
      ])

      container
        .from(baseImageAddress)
        .withExec(["npm", "install", "--global", "jsii-reflect@" + jsiiReflectVersion])
        .withMountedDirectory("/src", built.directory("/src"))
        .withWorkdir("/src")
        .withExec([
          "sh",
          "-c",
          "find . -name .jsii -not -path '*/node_modules/*' -print0 | xargs -0 -r -n1 jsii-tree --validate",
        ])
        .sync
    }

    null
  }

  """
  Paths that installing and building create. A stale build info would let
  `tsc --build` skip a project and pass without checking it.
  """
  let installed: [String!]! = [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/.tsbuild",
    "**/*.tsbuildinfo",
  ]

  """
  What pnpm reads to resolve and install: the lock file, its settings, patches
  and pnpmfiles, and every workspace manifest. The dependencies install from
  these alone, and their build scripts run, in layers that a change to any
  other file leaves cached. The workspace's own `prepare` and `postinstall`
  scripts wait for the whole source: pnpm skips them when a second install has
  nothing to do, so `pnpm rebuild --pending` runs them afterwards. The install
  before it only brings directory dependencies, which these inputs hold just the
  manifests of, up to date.
  """
  let installInputs: Directory! {
    source.filter(include: [
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "**/.npmrc",
      "**/package.json",
      "**/*.patch",
      "**/.pnpmfile.*",
    ])
  }

  # renovate: datasource=npm depName=jsii-reflect
  let jsiiReflectVersion: String! = "1.142.0"

  # renovate: datasource=npm depName=corepack
  let corepackVersion: String! = "0.36.0"

  """
  The workspace with its dependencies installed from the lock file, in `/src`.
  """
  pub base: Container! {
    container
      .from(baseImageAddress)
      .withMountedCache("/pnpm/store", cacheVolume("pnpm-store"))
      .withEnvVariable("PNPM_CONFIG_STORE_DIR", "/pnpm/store")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("HUSKY", "0")
      .withExec(["npm", "install", "--global", "corepack@" + corepackVersion])
      .withExec(["corepack", "enable"])
      .withFile("/src/package.json", source.file("package.json"))
      .withWorkdir("/src")
      .withExec(["pnpm", "--version"])
      .withDirectory("/src", installInputs)
      .withExec(["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"])
      .withExec(["pnpm", "rebuild"])
      .withDirectory("/src", source)
      .withExec(["pnpm", "install", "--frozen-lockfile", "--ignore-scripts"])
      .withExec(["pnpm", "rebuild", "--pending"])
  }
}
