"""
Type-checks for pnpm workspaces: every TypeScript project reference, built with
the `tsc` the lock file installs.
"""
type Typescript {
  """
  The workspace source, without what installing and building create.
  """
  pub source: Directory!

  """
  The base image to use.
  """
  pub baseImageAddress: String!

  """
  The projects to build, as `tsc --build` takes them: a directory or a tsconfig
  file, relative to the workspace root.
  """
  pub projects: [String!]!

  new(
    ws: Workspace!,
    baseImageAddress: String! = "node:24-slim",
    projects: [String!]! = ["."],
  ) {
    self.source = ws.directory("/", exclude: installed)
    self.baseImageAddress = baseImageAddress
    self.projects = projects
    self
  }

  """
  Type-check every project and the references they build.
  """
  pub typeCheck: Void @check {
    base.withExec(["pnpm", "exec", "tsc", "--build"] + projects).sync

    null
  }

  """
  Paths that installing and building create. A stale build info would let
  `tsc --build` skip a project and pass without checking it.
  """
  let installed: [String!]! = [
    "**/node_modules",
    "**/dist",
    "**/.next",
    "**/.tsbuild",
    "**/*.tsbuildinfo",
  ]

  """
  The workspace with its dependencies installed from the lock file.
  """
  let base: Container! {
    container
      .from(baseImageAddress)
      .withMountedCache("/pnpm/store", cacheVolume("pnpm-store"))
      .withEnvVariable("npm_config_store_dir", "/pnpm/store")
      .withEnvVariable("COREPACK_ENABLE_DOWNLOAD_PROMPT", "0")
      .withEnvVariable("CI", "true")
      .withEnvVariable("HUSKY", "0")
      .withExec(["corepack", "enable"])
      .withDirectory("/src", source)
      .withWorkdir("/src")
      .withExec(["pnpm", "install", "--frozen-lockfile"])
  }
}
